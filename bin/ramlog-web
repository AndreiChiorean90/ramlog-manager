#!/usr/bin/env python3
"""RAMLog Manager standalone policy UI (stdlib only)."""
import html
import json
import os
from pathlib import Path
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

HOST = "0.0.0.0"
PORT = 7780
POLICY = Path("/etc/ramlog/policy.json")
CANDIDATES = [
    ("systemd-journald", "/run/log/journal", "journal"),
    ("rsyslog", "/run/rsyslog", "rsyslog"),
    ("Apache", "/var/log/apache2", "apache2"),
    ("Nginx", "/var/log/nginx", "nginx"),
    ("PHP-FPM", "/var/log/php8.4-fpm.log", "php-fpm"),
    ("PostgreSQL", "/var/log/postgresql", "postgresql"),
    ("Mattermost", "/opt/mattermost/logs", "mattermost"),
    ("LightDM", "/var/log/lightdm", "lightdm"),
    ("Xorg", "/var/log/Xorg.0.log", "xorg"),
]

def load_policy():
    try:
        return json.loads(POLICY.read_text())
    except (OSError, ValueError):
        return {}

def page():
    policy = load_policy()
    rows = []
    for name, path, key in CANDIDATES:
        selected = policy.get(key, {})
        mode = selected.get("mode", "HDD")
        checked = "checked" if selected.get("selected", False) else ""
        exists = Path(path).exists()
        rows.append(f"""
        <tr>
          <td><input class="pick" type="checkbox" name="selected_{key}" value="1" {checked}></td>
          <td>{html.escape(name)}</td><td><code>{html.escape(path)}</code></td>
          <td><select name="mode_{key}" data-key="{key}">
            {''.join(f'<option value="{v}" {"selected" if mode == v else ""}>{v}</option>' for v in ("Disabled","RAM","HDD"))}
          </select></td>
          <td>{'Detected' if exists else 'Not detected'}</td>
        </tr>""")
    return f"""<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>RAMLog Manager</title><style>
body{{font:15px system-ui;background:#f4f6f8;color:#202832;margin:0;padding:28px}}
main{{max-width:1100px;margin:auto;background:white;padding:26px;border-radius:12px;box-shadow:0 2px 14px #0001}}
h1{{margin-top:0}}table{{width:100%;border-collapse:collapse}}th,td{{padding:12px 9px;border-bottom:1px solid #e4e8ec;text-align:left}}
th{{background:#f8fafb}}code{{font-size:12px;overflow-wrap:anywhere}}select{{padding:8px;border:1px solid #bbc5cf;border-radius:6px}}
button{{margin-top:22px;padding:12px 25px;background:#175cd3;color:white;border:0;border-radius:7px;font-weight:650;cursor:pointer}}
.note{{padding:12px;background:#fff7e6;border:1px solid #f1d28a;border-radius:7px;margin:18px 0}}
.status{{color:#52606d;font-size:13px}}
</style></head><body><main><h1>RAMLog Manager</h1>
<p class="status">Standalone control panel · {PORT} · Host: {html.escape(os.uname().nodename)}</p>
<div class="note"><b>Policy editor:</b> Apply currently saves selected per-log policy choices. It does not yet change live service configurations. Live activation is deliberately withheld until a source-specific adapter can validate and safely apply each choice.</div>
<form method="post" action="/apply"><table><thead><tr><th>Apply</th><th>Log source</th><th>Current path</th><th>Policy</th><th>Detection</th></tr></thead>
<tbody>{''.join(rows)}</tbody></table><button type="submit">Apply selected changes</button></form>
<p class="status">Changing a policy automatically selects its row. Unchecked rows are not changed.</p></main>
<script>
document.querySelectorAll('select').forEach(s=>s.addEventListener('change',()=>{const row=s.closest('tr');row.querySelector('.pick').checked=true;}));
</script></body></html>"""

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in ("/", "/index.html"):
            self.send_error(404); return
        data = page().encode()
        self.send_response(200); self.send_header("Content-Type","text/html; charset=utf-8")
        self.send_header("Content-Length",str(len(data))); self.end_headers(); self.wfile.write(data)

    def do_POST(self):
        if self.path != "/apply":
            self.send_error(404); return
        if os.geteuid() != 0:
            self.send_error(403, "Run ramlog-web as root"); return
        raw = self.rfile.read(int(self.headers.get("Content-Length","0"))).decode()
        form = parse_qs(raw)
        old = load_policy()
        for _, _, key in CANDIDATES:
            if form.get("selected_"+key, [""])[0] == "1":
                mode = form.get("mode_"+key, ["HDD"])[0]
                if mode not in ("Disabled","RAM","HDD"):
                    self.send_error(400); return
                old[key] = {"selected": True, "mode": mode}
        POLICY.parent.mkdir(parents=True, exist_ok=True)
        tmp = POLICY.with_suffix(".tmp")
        tmp.write_text(json.dumps(old, indent=2)+"\n")
        os.chmod(tmp, 0o600); os.replace(tmp, POLICY)
        self.send_response(303); self.send_header("Location","/"); self.end_headers()

    def log_message(self, fmt, *args):
        print("ramlog-web:", fmt % args, flush=True)

if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
