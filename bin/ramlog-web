#!/usr/bin/env python3
"""RAMLog Manager web interface with live log inventory and guarded actions."""
import html
import json
import os
from pathlib import Path
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

HOST = "0.0.0.0"
PORT = 7780
POLICY = Path("/etc/ramlog/policy.json")
RAMLOG = "/usr/local/sbin/ramlog"
CANDIDATES = [
    ("systemd-journald", "/run/log/journal", "journal"),
    ("rsyslog", "/run/rsyslog", "rsyslog"),
    ("Apache", "/var/log/apache2", "apache2"),
    ("Nginx", "/var/log/nginx", "nginx"),
    ("PHP-FPM", "/var/log/php8.4-fpm.log", "php-fpm"),
    ("PostgreSQL", "/var/log/postgresql", "postgresql"),
    ("Mattermost", "/opt/mattermost/logs", "mattermost"),
    ("LightDM", "/var/log/lightdm", "lightdm"),
    ("Xorg", "/var/log/Xorg.0.log", "xorg"),
]

def load_policy():
    try:
        data = json.loads(POLICY.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}

def scan_inventory():
    if not Path(RAMLOG).is_file() or not os.access(RAMLOG, os.X_OK):
        return "RAMLog CLI missing or not executable", False
    proc = subprocess.run([RAMLOG, "inventory"], text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, timeout=90, check=False,
                          env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                               "LANG": "C.UTF-8"})
    if proc.returncode:
        return proc.stdout.strip() or "Inventory failed", False
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        return "Invalid inventory output:\n" + proc.stdout, False
    lines = [f"Inventory generated: {data.get('generated', 'unknown')}", ""]
    for item in data.get("logs", []):
        writers = ", ".join(f"PID {w['pid']} FD {w['fd']}" for w in item.get("writers", [])) or "no active writer identified"
        lines.append(f"{item['state']:8} | {item['source']} | {item['path']} | {item.get('filesystem', 'unknown')} | {writers}")
    lines.extend(["", data.get("note", "")])
    return "\n".join(lines), True

def page(message="", success=None, scan_message=""):
    policy = load_policy()
    rows = []
    for name, path, key in CANDIDATES:
        selected = policy.get(key, {})
        mode = selected.get("mode", "HDD")
        checked = "checked" if selected.get("selected", False) else ""
        exists = Path(path).exists()
        rows.append(f"""
        <tr>
          <td><input class="pick" type="checkbox" name="selected_{key}" value="1" {checked}></td>
          <td>{html.escape(name)}</td><td><code>{html.escape(path)}</code></td>
          <td><select name="mode_{key}" data-key="{key}">
            {''.join(f'<option value="{v}" {"selected" if mode == v else ""}>{v}</option>' for v in ("Disabled","RAM","HDD"))}
          </select></td>
          <td>{'Detected' if exists else 'Not detected'}</td>
        </tr>""")
    result = ""
    if scan_message:
        result += f'<section class="result"><b>Live log inventory</b><pre>{html.escape(scan_message)}</pre></section>'
    if message:
        color = "#e8f5e9" if success else "#fff0f0"
        result = f'<section class="result" style="background:{color}"><b>{"Apply result" if success else "Apply not completed"}</b><pre>{html.escape(message)}</pre></section>'
    return f"""<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>RAMLog Manager</title><style>
body{{font:15px system-ui;background:#f4f6f8;color:#202832;margin:0;padding:28px}}
main{{max-width:1100px;margin:auto;background:white;padding:26px;border-radius:12px;box-shadow:0 2px 14px #0001}}
h1{{margin-top:0}}table{{width:100%;border-collapse:collapse}}th,td{{padding:12px 9px;border-bottom:1px solid #e4e8ec;text-align:left}}
th{{background:#f8fafb}}code{{font-size:12px;overflow-wrap:anywhere}}select{{padding:8px;border:1px solid #bbc5cf;border-radius:6px}}
button{{margin-top:22px;padding:12px 25px;background:#175cd3;color:white;border:0;border-radius:7px;font-weight:650;cursor:pointer}}
.note{{padding:12px;background:#fff7e6;border:1px solid #f1d28a;border-radius:7px;margin:18px 0}}
.result{{padding:12px;border:1px solid #ccd4dc;border-radius:7px;margin:18px 0;overflow:auto}}
pre{{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}}
.status{{color:#52606d;font-size:13px}}
</style></head><body><main><h1>RAMLog Manager</h1>
<p class="status">Control panel · {PORT} · Host: {html.escape(os.uname().nodename)}</p>
<form method="post" action="/scan"><button type="submit">Check current log status</button></form>
<div class="note"><b>Live inventory:</b> the status check inspects active log file descriptors and classifies their backing filesystem. Explicitly disabled logging is shown only when configuration proves it; unknown sources are not guessed.</div>
<div class="note"><b>Apply safety:</b> This build activates the existing guarded bulk RAM adapter only when all nine listed sources are selected and set to RAM. Mixed policies (HDD/Disabled or unchecked rows) are saved but not activated; they require per-source adapters that are not yet implemented. Review the execution output below after applying.</div>
{result}
<form method="post" action="/mattermost-fix"><button type="submit" onclick="return confirm('Correct Mattermost FileLocation and restart only Mattermost?')">Correct Mattermost RAM log path (restart Mattermost only)</button></form>
<form method="post" action="/apply"><table><thead><tr><th>Select</th><th>Log source</th><th>Current path</th><th>Policy</th><th>Detection</th></tr></thead>
<tbody>{''.join(rows)}</tbody></table><button type="submit">Save and apply RAM policy</button></form>
<p class="status">This interface is unauthenticated HTTP. Keep TCP {PORT} restricted to the trusted management LAN; never expose it to the Internet.</p></main>
<script>
document.querySelectorAll('select').forEach(s=>s.addEventListener('change',()=>{{const row=s.closest('tr');row.querySelector('.pick').checked=true;}}));
</script></body></html>"""

class Handler(BaseHTTPRequestHandler):
    def send_page(self, message="", success=None, status=200, scan_message=""):
        data = page(message, success, scan_message).encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path not in ("/", "/index.html"):
            self.send_error(404)
            return
        self.send_page()

    def do_POST(self):
        if self.path == "/scan":
            if os.geteuid() != 0:
                self.send_error(403, "Run ramlog-web as root")
                return
            try:
                message, ok = scan_inventory()
                self.send_page(scan_message=message)
            except subprocess.TimeoutExpired:
                self.send_page(scan_message="Inventory timed out; no changes were made.")
            return
        if self.path == "/mattermost-fix":
            if os.geteuid() != 0:
                self.send_error(403, "Run ramlog-web as root")
                return
            try:
                proc = subprocess.run([RAMLOG, "mattermost-fix"], text=True, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT, timeout=180, check=False,
                                      env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                                           "LANG": "C.UTF-8"})
                self.send_page(proc.stdout.strip() or "(no output)", proc.returncode == 0,
                               status=200 if proc.returncode == 0 else 500)
            except subprocess.TimeoutExpired:
                self.send_page("Mattermost-only action timed out. Inspect service state before retrying.", False, 504)
            return
        if self.path != "/apply":
            self.send_error(404)
            return
        if os.geteuid() != 0:
            self.send_error(403, "Run ramlog-web as root")
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self.send_error(400, "Invalid Content-Length")
            return
        if length <= 0 or length > 65536:
            self.send_error(413, "Invalid request size")
            return
        form = parse_qs(self.rfile.read(length).decode("utf-8", "replace"))
        new_policy = load_policy()
        selected_all_ram = True
        for _, _, key in CANDIDATES:
            selected = form.get("selected_" + key, [""])[0] == "1"
            mode = form.get("mode_" + key, ["HDD"])[0]
            if mode not in ("Disabled", "RAM", "HDD"):
                self.send_error(400, "Invalid policy value")
                return
            new_policy[key] = {"selected": selected, "mode": mode}
            if not selected or mode != "RAM":
                selected_all_ram = False

        POLICY.parent.mkdir(parents=True, exist_ok=True)
        tmp = POLICY.with_suffix(".tmp")
        tmp.write_text(json.dumps(new_policy, indent=2) + "\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, POLICY)

        if not selected_all_ram:
            self.send_page(
                "Policy saved to /etc/ramlog/policy.json. NO service configuration was changed. "
                "This release activates only the all-sources-RAM policy; mixed policies are not yet supported.",
                False, 200)
            return
        if not Path(RAMLOG).is_file() or not os.access(RAMLOG, os.X_OK):
            self.send_page("Policy saved, but the RAMLog CLI is missing or not executable: " + RAMLOG, False, 500)
            return
        try:
            proc = subprocess.run([RAMLOG, "apply"], text=True, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, timeout=300, check=False,
                                  env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                                       "LANG": "C.UTF-8"})
            output = proc.stdout.strip() or "(no output)"
            if proc.returncode == 0:
                check = subprocess.run([RAMLOG, "verify"], text=True, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, timeout=120, check=False,
                                       env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                                            "LANG": "C.UTF-8"})
                verified = check.stdout.strip() or "(no verification output)"
                if check.returncode == 0:
                    self.send_page("Adapter completed and verification returned PASS.\\n\\n" +
                                   output + "\\n\\n=== POST-APPLY VERIFICATION ===\\n" + verified, True)
                else:
                    self.send_page("Adapter ran, but verification is FAIL/INCOMPLETE. Do not treat this host as compliant.\\n\\n" +
                                   output + "\\n\\n=== POST-APPLY VERIFICATION ===\\n" + verified, False, 500)
            else:
                self.send_page("Policy saved, but adapter exited with code " + str(proc.returncode) +
                               ". Review the output; configuration rollback is attempted by the CLI on failure.\\n\\n" +
                               output, False, 500)
        except subprocess.TimeoutExpired as exc:
            output = (exc.stdout or b"").decode(errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
            self.send_page("Apply timed out after 300 seconds. Inspect service state before retrying.\n\n" + output, False, 504)

    def log_message(self, fmt, *args):
        print("ramlog-web:", fmt % args, flush=True)

if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
