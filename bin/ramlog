#!/usr/bin/env python3
"""RAMLog Manager 0.3.5 — guarded RAM logging adapters.

Debian/Ubuntu + systemd. Changes are backed up before application.
Unsupported sources are reported; they are never silently declared compliant.
"""
import argparse
import configparser
import datetime as dt
import hashlib
import grp
import json
import os
import pwd
from pathlib import Path
import re
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile

VERSION = "0.3.6"
CONFIG = Path("/etc/ramlog/ramlog.conf")
BACKUP_ROOT = Path("/var/backups/ramlog-manager")
RUNTIME = Path("/run/bjm-app-logs")
JOURNAL_DROPIN = Path("/etc/systemd/journald.conf.d/99-ramlog-manager.conf")
JOURNAL_CONTENT = "[Journal]\nStorage=volatile\nRuntimeMaxUse=200M\nRuntimeKeepFree=50M\n"
TMPFILES = Path("/etc/tmpfiles.d/ramlog-manager.conf")
MANAGED_PATHS = [
    "/run/log/journal", "/run/rsyslog", "/run/bjm-app-logs",
    "/run/bjm-app-logs/apache2", "/run/bjm-app-logs/nginx",
    "/run/bjm-app-logs/php-fpm", "/run/bjm-app-logs/postgresql",
    "/run/bjm-app-logs/mattermost",
]
CHANGES = []
RESTARTS = set()
UNSUPPORTED = []

def run(cmd):
    try:
        p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, check=False)
        return p.returncode, p.stdout.strip()
    except FileNotFoundError:
        return 127, f"{cmd[0]}: not installed"

def require_root():
    if os.geteuid() != 0:
        raise SystemExit("Run as root.")

def read_config():
    cfg = configparser.ConfigParser()
    if CONFIG.exists():
        cfg.read(CONFIG)
    paths = cfg.get("sources", "paths",
                    fallback="/run/log/journal,/run/rsyslog,/run/bjm-app-logs").split(",")
    archive = cfg.get("archive", "directory", fallback="/var/log/ramlog-archive")
    return [Path(p.strip()) for p in paths if p.strip()], Path(archive.strip())

def mount_type(path):
    if not path.exists():
        return "missing"
    rc, out = run(["findmnt", "-n", "-o", "FSTYPE", "--target", str(path)])
    return out if rc == 0 and out else "unknown"

def is_ram(path):
    return mount_type(path) in ("tmpfs", "ramfs")

def backup(path):
    path = Path(path)
    if not path.exists() and not path.is_symlink():
        return None
    stamp = dt.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
    dest = BACKUP_ROOT / stamp / path.relative_to("/")
    dest.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        dest.symlink_to(os.readlink(path))
    else:
        shutil.copy2(path, dest)
        st = path.stat()
        os.chown(dest, st.st_uid, st.st_gid)
    return dest

def record_write(path, data, mode=None):
    path = Path(path)
    old = path.read_bytes() if path.exists() else None
    if old == data:
        return False
    saved = backup(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="."+path.name+".", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        if mode is not None:
            os.chmod(tmp, mode)
        elif path.exists():
            st = path.stat()
            os.chmod(tmp, st.st_mode & 0o7777)
            os.chown(tmp, st.st_uid, st.st_gid)
        if path.exists():
            st = path.stat()
            os.chown(tmp, st.st_uid, st.st_gid)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    CHANGES.append((path, saved, old))
    return True

def rollback():
    for path, saved, old in reversed(CHANGES):
        try:
            if old is None:
                path.unlink(missing_ok=True)
            else:
                path.write_bytes(old)
                if saved and saved.exists():
                    shutil.copystat(saved, path)
                    os.chown(path, saved.stat().st_uid, saved.stat().st_gid)
        except OSError as exc:
            print(f"ROLLBACK ERROR {path}: {exc}", file=sys.stderr)

def set_text(path, transform, mode=None):
    path = Path(path)
    if not path.exists():
        return False
    original = path.read_text(errors="replace")
    updated = transform(original)
    return record_write(path, updated.encode(), mode)

def ensure_line(text, pattern, line):
    if re.search(pattern, text, re.M):
        return re.sub(pattern, line, text, flags=re.M)
    return text.rstrip() + "\n" + line + "\n"

def configure_runtime():
    rules = [
        "d /run/bjm-app-logs 0755 root root -",
        "d /run/bjm-app-logs/apache2 0755 root root -",
        "d /run/bjm-app-logs/nginx 0755 root root -",
        "d /run/bjm-app-logs/php-fpm 0755 root root -",
        "d /run/bjm-app-logs/lightdm 0755 root root -",
    ]
    # Only reference service accounts that actually exist on this host.
    for user, group, path in (
        ("postgres", "postgres", "/run/bjm-app-logs/postgresql"),
        ("mattermost", "mattermost", "/run/bjm-app-logs/mattermost"),
        ("syslog", "adm", "/run/rsyslog"),
    ):
        try:
            pwd.getpwnam(user)
            grp.getgrnam(group)
            rules.append(f"d {path} 0750 {user} {group} -")
        except KeyError:
            continue
    rules.append("")
    record_write(TMPFILES, "\n".join(rules).encode(), 0o644)
    rc, out = run(["systemd-tmpfiles", "--create", str(TMPFILES)])
    if rc:
        raise RuntimeError("tmpfiles creation failed: " + out)
    if not Path("/run").is_mount() or not is_ram(Path("/run")):
        raise RuntimeError("/run is not mounted on tmpfs/ramfs; refusing RAM logging setup")

def configure_journald():
    JOURNAL_DROPIN.parent.mkdir(parents=True, exist_ok=True)
    if record_write(JOURNAL_DROPIN, JOURNAL_CONTENT.encode(), 0o644):
        RESTARTS.add("systemd-journald")

def configure_rsyslog():
    confdir = Path("/etc/rsyslog.d")
    if not Path("/usr/sbin/rsyslogd").exists():
        return
    rules = [Path("/etc/rsyslog.conf")] + sorted(confdir.glob("*.conf"))
    destinations = []
    for f in rules:
        txt = f.read_text(errors="replace")
        if f.name.startswith("00-ram-logging"):
            continue
        for line in txt.splitlines():
            s = line.strip()
            if s and not s.startswith("#") and re.search(r"/var/log/", s):
                destinations.append(f"{f}:{line.strip()}")
    # Do not replace user rules automatically. Existing RAM rules are detected and preserved.
    ram_rules = confdir / "00-ram-logging.conf"
    if ram_rules.exists():
        text = ram_rules.read_text(errors="replace")
        if "/run/rsyslog" in text:
            if destinations:
                UNSUPPORTED.extend(["rsyslog has additional persistent destination: " + x for x in destinations])
                return
            print("rsyslog: existing RAM destination rules detected; preserved.")
            return
    if destinations:
        UNSUPPORTED.extend(["rsyslog persistent rule needs rule-specific translation: " + x for x in destinations])
        return
    UNSUPPORTED.append("rsyslog: no verified RAM destination rules found")

def configure_apache():
    env = Path("/etc/apache2/envvars")
    if not env.exists():
        return
    changed = set_text(env, lambda t: ensure_line(
        t, r"^\s*export\s+APACHE_LOG_DIR=.*$",
        "export APACHE_LOG_DIR=/run/bjm-app-logs/apache2"))
    if changed:
        RESTARTS.add("apache2")
    print("Apache: APACHE_LOG_DIR redirected through its global environment file.")

def nginx_config_files():
    root = Path("/etc/nginx")
    found = {}
    if not root.exists():
        return []
    for p in root.rglob("*.conf"):
        try:
            resolved = p.resolve(strict=True)
            if resolved.is_file():
                found[str(resolved)] = resolved
        except OSError:
            pass
    return list(found.values())

def configure_nginx():
    if not Path("/usr/sbin/nginx").exists():
        return
    changed_any = False
    for path in nginx_config_files():
        if "ramlog-manager" in str(path):
            continue
        def transform(text):
            def replace_directive(match):
                indent, directive, rest = match.group(1), match.group(2), match.group(3)
                parts = rest.split()
                if not parts or (directive == "access_log" and parts[0] == "off"):
                    return match.group(0)
                target = "/run/bjm-app-logs/nginx/" + (
                    "access.log" if directive == "access_log" else "error.log")
                suffix = " ".join(parts[1:])
                return f"{indent}{directive} {target}" + (f" {suffix}" if suffix else "") + ";"
            return re.sub(r"^(\s*)(access_log|error_log)\s+([^;]*);",
                          replace_directive, text, flags=re.M)
        if set_text(path, transform):
            changed_any = True
    if changed_any:
        rc, out = run(["nginx", "-t"])
        if rc:
            raise RuntimeError("nginx configuration test failed: " + out)
        RESTARTS.add("nginx")
    print("Nginx: configured access/error destinations redirected and syntax checked.")

def configure_php_fpm():
    p = Path("/etc/php")
    changed = False
    if p.exists():
        for cfg in p.glob("*/fpm/php-fpm.conf"):
            def transform(t):
                return ensure_line(t, r"^\s*error_log\s*=.*$",
                                   "error_log = /run/bjm-app-logs/php-fpm/php-fpm.log")
            cfg_changed = set_text(cfg, transform)
            changed |= cfg_changed
            if cfg_changed:
                RESTARTS.add(f"php{cfg.parts[3]}-fpm")
    print("PHP-FPM: global error log redirected for installed FPM configurations.")

def configure_postgresql():
    root = Path("/etc/postgresql")
    if not root.exists():
        return
    for cfg in root.glob("*/*/postgresql.conf"):
        ver = cfg.parent.parent.name
        cluster = cfg.parent.name
        rc, out = run(["pg_lsclusters"])
        if rc or not re.search(rf"(?m)^\s*{re.escape(ver)}\s+{re.escape(cluster)}\s+\d+\s+online\b", out):
            UNSUPPORTED.append(f"PostgreSQL {ver}/{cluster}: cluster not online; left unchanged")
            continue
        override = cfg.parent / "conf.d" / "ramlog-manager.conf"
        override.parent.mkdir(parents=True, exist_ok=True)
        body = ("# Managed by RAMLog Manager; local changes will be overwritten.\n"
                "logging_collector = on\n"
                "log_destination = 'stderr'\n"
                "log_directory = '/run/bjm-app-logs/postgresql'\n"
                "log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'\n")
        # Include this exact managed file at the end of the main configuration.
        # A pre-existing include_dir does not guarantee that this override wins.
        text = cfg.read_text(errors="replace")
        include = "include_if_exists = 'conf.d/ramlog-manager.conf'"
        updated = ensure_line(text, r"^\s*include_if_exists\s*=\s*'conf.d/ramlog-manager\.conf'\s*$", include)
        main_changed = record_write(cfg, updated.encode()) if updated != text else False
        override_changed = record_write(override, body.encode(), 0o640)
        os.chown(override, 0, grp.getgrnam("postgres").gr_gid)
        if main_changed or override_changed:
            RESTARTS.add(f"postgresql@{ver}-{cluster}")
            print(f"PostgreSQL {ver}/{cluster}: RAM log collector configured; restart required.")

def configure_mattermost():
    cfg = Path("/opt/mattermost/config/config.json")
    if not cfg.exists():
        return
    try:
        data = json.loads(cfg.read_text())
        settings = data.setdefault("LogSettings", {})
        settings["EnableFile"] = True
        settings["FileLocation"] = "/run/bjm-app-logs/mattermost"
        # Keep console logging and existing log levels/format unchanged.
        changed = record_write(cfg, (json.dumps(data, indent="\t")+"\n").encode(), cfg.stat().st_mode & 0o777)
        if changed:
            RESTARTS.add("mattermost")
        print("Mattermost: file logging directed to RAM; console settings preserved.")
    except Exception as exc:
        UNSUPPORTED.append(f"Mattermost config not changed: {exc}")

def mattermost_fix():
    """Correct Mattermost's RAM log directory and restart only Mattermost."""
    require_root()
    cfg = Path("/opt/mattermost/config/config.json")
    if not cfg.is_file():
        raise SystemExit("Mattermost configuration not found; no changes made.")
    active = run(["systemctl", "is-active", "mattermost"])[1]
    if active != "active":
        raise SystemExit(f"Mattermost is not active ({active}); refusing an automatic start/restart.")
    try:
        data = json.loads(cfg.read_text())
        settings = data.setdefault("LogSettings", {})
        settings["EnableFile"] = True
        settings["FileLocation"] = "/run/bjm-app-logs/mattermost"
        updated = (json.dumps(data, indent="\\t") + "\\n").encode()
        changed = record_write(cfg, updated, cfg.stat().st_mode & 0o777)
        if changed:
            rc, output = run(["systemctl", "restart", "mattermost"])
            if rc:
                rollback()
                run(["systemctl", "restart", "mattermost"])
                raise RuntimeError("Mattermost restart failed; configuration rollback attempted: " + output)
            print("Mattermost configuration corrected and only the Mattermost service restarted.")
            print(f"Backup location: {BACKUP_ROOT}")
        else:
            print("Mattermost already has the expected RAM log directory; no restart required.")
    except Exception as exc:
        raise SystemExit(f"Mattermost-only correction failed: {exc}")


def configure_lightdm():
    if not Path("/usr/sbin/lightdm").exists():
        return
    dropin = Path("/etc/lightdm/lightdm.conf.d/99-ramlog-manager.conf")
    body = ("[LightDM]\n"
            "log-directory=/run/bjm-app-logs/lightdm\n"
            "[Seat:*]\n"
            "xserver-command=X -core -logfile /run/bjm-app-logs/lightdm/Xorg.0.log\n")
    record_write(dropin, body.encode(), 0o644)
    # Do not restart LightDM automatically: doing so terminates active GUI sessions.
    # The config is staged for the next planned reboot; verify will still flag
    # currently open persistent log descriptors until LightDM/Xorg are restarted.
    print("LightDM/Xorg: RAM log paths staged; activation deferred until a planned reboot (no GUI session terminated).")

def configure_logrotate():
    """Bound RAM log growth; copytruncate keeps writers on their RAM-backed inode."""
    if not shutil.which("logrotate"):
        raise RuntimeError("logrotate is required to bound RAM log growth; install it before applying")
    path = Path("/etc/logrotate.d/ramlog-manager")
    body = """# Managed by RAMLog Manager. All paths below are RAM-backed under /run.
# Keep RAM usage bounded without touching persistent historical logs.
/run/rsyslog/* /run/bjm-app-logs/apache2/*.log /run/bjm-app-logs/nginx/*.log /run/bjm-app-logs/php-fpm/*.log /run/bjm-app-logs/postgresql/*.log /run/bjm-app-logs/mattermost/*.log /run/bjm-app-logs/lightdm/*.log {
    daily
    maxsize 20M
    rotate -1
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
"""
    record_write(path, body.encode(), 0o644)
    rc, out = run(["logrotate", "-d", "/etc/logrotate.conf"])
    if rc:
        raise RuntimeError("logrotate configuration validation failed: " + out)
    print("logrotate: RAM log rotation configured (daily or above 20 MiB; retain all rotations).")

def configure():
    require_root()
    CHANGES.clear()
    RESTARTS.clear()
    UNSUPPORTED.clear()
    if not Path("/run").is_mount() or not is_ram(Path("/run")):
        raise SystemExit("REFUSED: /run must be a tmpfs/ramfs mount")
    try:
        configure_runtime()
        configure_logrotate()
        configure_journald()
        configure_rsyslog()
        configure_apache()
        configure_nginx()
        configure_php_fpm()
        configure_postgresql()
        configure_mattermost()
        configure_lightdm()
        # Validate configuration before service restarts.
        for cmd in (["apache2ctl", "-t"], ["nginx", "-t"], ["php-fpm8.4", "-t"], ["rsyslogd", "-N1"]):
            if shutil.which(cmd[0]):
                rc, out = run(cmd)
                if rc:
                    raise RuntimeError(f"{cmd[0]} validation failed: {out}")
        if UNSUPPORTED:
            raise RuntimeError("unsupported logging sources: " + "; ".join(UNSUPPORTED))
        for svc in sorted(RESTARTS):
            rc, out = run(["systemctl", "restart", svc])
            if rc:
                raise RuntimeError(f"restart {svc} failed: {out}")
        print("\nApplied RAM logging adapters:")
        print(" - systemd-journald")
        print(" - Apache global log directory")
        print(" - Nginx configured access/error destinations")
        print(" - PHP-FPM global error logs")
        print(" - PostgreSQL clusters with managed collector config")
        print(" - Mattermost file log directory")
        print(" - LightDM/Xorg log paths staged for next planned reboot (not restarted)")
        print(" - rsyslog existing RAM rules preserved (not rewritten)")
        if UNSUPPORTED:
            print("\nUNSUPPORTED / NEEDS ATTENTION:")
            for item in UNSUPPORTED:
                print(" - " + item)
        print(f"\nBackups: {BACKUP_ROOT}")
        print("Configuration stage completed. Some sources may still require activation or a planned reboot.")
        print("Run ramlog verify; this host is NOT compliant unless verification returns PASS.")
        print("Apply completed. Run 'ramlog verify' for the current compliance result.")
    except Exception as exc:
        print(f"APPLY FAILED: {exc}; restoring changed configuration.", file=sys.stderr)
        rollback()
        for svc in sorted(RESTARTS):
            run(["systemctl", "restart", svc])
        raise SystemExit(2)

def open_persistent_writers():
    """Return unique process/PID/FD/path tuples for open persistent log files."""
    if not shutil.which("lsof"):
        return None
    rc, out = run(["lsof", "-nP", "-w", "-Fpcfn"])
    if rc and not out:
        return []
    current_pid = current_command = current_fd = None
    found = {}
    for line in out.splitlines():
        if not line:
            continue
        kind, value = line[0], line[1:]
        if kind == "p":
            current_pid, current_command, current_fd = value, None, None
        elif kind == "c":
            current_command = value
        elif kind == "f":
            current_fd = value
        elif kind == "n" and current_pid and current_fd:
            name = value
            if (name.startswith("/var/log/")
                    and not name.startswith("/var/log/ramlog-archive/")
                    and not name.startswith("/var/log/log-archive/")):
                key = (current_pid, current_fd, name)
                if key not in found:
                    try:
                        command = Path("/proc") .joinpath(current_pid, "comm").read_text().strip()
                    except OSError:
                        command = current_command or "unknown"
                    found[key] = f"{command} {current_pid} {current_fd} {name}"
    return sorted(found.values())

def postgresql_verification():
    """Report PostgreSQL's effective log settings and logger file descriptors."""
    findings = []
    rc, clusters = run(["pg_lsclusters"])
    if rc:
        return ["PostgreSQL status unavailable: " + clusters]
    for line in clusters.splitlines():
        m = re.match(r"^\s*(\d+)\s+(\S+)\s+(\d+)\s+(online)\s+", line)
        if not m:
            continue
        ver, cluster, port, _ = m.groups()
        cmd = ["runuser", "-u", "postgres", "--", "psql", "-XAt", "-p", port,
               "-d", "postgres", "-v", "ON_ERROR_STOP=1", "-c",
               "SELECT current_setting('logging_collector') || '|' || "
               "current_setting('log_destination') || '|' || "
               "current_setting('log_directory') || '|' || "
               "current_setting('log_filename');"]
        qrc, output = run(cmd)
        rows = [x for x in output.splitlines() if "|" in x]
        if qrc or not rows:
            findings.append(f"PostgreSQL {ver}/{cluster}: effective logging settings unknown: {output}")
            continue
        collector, destination, directory, filename = rows[-1].split("|", 3)
        logdir = Path(directory)
        active_ram_config = collector == "on" and logdir.is_absolute() and str(logdir).startswith("/run/") and is_ram(logdir)
        findings.append(
            f"PostgreSQL {ver}/{cluster}: collector={collector}; destination={destination}; "
            f"log_directory={directory}; RAM destination={'verified' if active_ram_config else 'NOT verified'}"
        )
        if not active_ram_config:
            findings.append(f"PostgreSQL {ver}/{cluster}: effective configuration does not prove RAM logging")
        # Locate the cluster's logger process and inspect its own open descriptors.
        prc, processes = run(["ps", "-eo", "pid=,args="])
        logger_pids = []
        if prc == 0:
            for proc_line in processes.splitlines():
                pm = re.match(r"\s*(\d+)\s+.*postgres:\s+" +
                              re.escape(ver + "/" + cluster) + r":\s+logger\b", proc_line)
                if pm:
                    logger_pids.append(pm.group(1))
        if not logger_pids:
            findings.append(f"PostgreSQL {ver}/{cluster}: logger process not identified; active file destination unknown")
            continue
        for pid in logger_pids:
            lrc, opened = run(["lsof", "-nP", "-p", pid])
            if lrc:
                findings.append(f"PostgreSQL {ver}/{cluster}: cannot inspect logger PID {pid} descriptors: {opened}")
                continue
            paths = []
            ram_paths = []
            for opened_line in opened.splitlines()[1:]:
                fields = opened_line.split()
                if fields:
                    name = fields[-1]
                    if name.startswith("/var/log/") and "/var/log/ramlog-archive/" not in name:
                        paths.append(name)
                    elif (name.startswith(str(logdir).rstrip("/") + "/")
                          and is_ram(logdir)):
                        ram_paths.append(name)
            if ram_paths:
                for path in sorted(set(ram_paths)):
                    findings.append(f"PostgreSQL {ver}/{cluster}: logger PID {pid} has RAM log file open: {path}")
            else:
                findings.append(f"PostgreSQL {ver}/{cluster}: logger PID {pid} has no identifiable RAM log file descriptor")
            if paths:
                for path in sorted(set(paths)):
                    findings.append(
                        f"PostgreSQL {ver}/{cluster}: logger PID {pid} still holds persistent log descriptor {path}; "
                        "verification remains incomplete until a controlled restart closes it"
                    )
            else:
                findings.append(f"PostgreSQL {ver}/{cluster}: logger PID {pid} has no detected persistent /var/log descriptor")
    return findings

def mattermost_verification():
    """Verify Mattermost's configured RAM log directory and active file descriptor."""
    cfg = Path("/opt/mattermost/config/config.json")
    if not cfg.exists():
        return ["Mattermost: not installed; skipped"]
    findings = []
    try:
        data = json.loads(cfg.read_text())
        settings = data.get("LogSettings", {})
    except Exception as exc:
        return [f"Mattermost: cannot read logging configuration: {exc}"]
    if not settings.get("EnableFile", False):
        return ["Mattermost: file logging is disabled"]
    expected = Path("/run/bjm-app-logs/mattermost")
    configured = Path(str(settings.get("FileLocation", "")))
    if configured != expected:
        findings.append(
            f"Mattermost: FileLocation is {configured}; expected RAM log directory {expected}"
        )
    if not expected.is_dir() or not is_ram(expected):
        findings.append(f"Mattermost: log directory missing or not RAM-backed: {expected}")
        return findings
    rc, pid_text = run(["systemctl", "show", "-p", "MainPID", "--value", "mattermost"])
    if rc or not pid_text.isdigit() or int(pid_text) <= 1:
        findings.append("Mattermost: active main process PID unavailable")
        return findings
    pid = pid_text
    lrc, opened = run(["lsof", "-nP", "-p", pid])
    if lrc:
        findings.append(f"Mattermost: cannot inspect PID {pid} file descriptors: {opened}")
        return findings
    active = []
    for line in opened.splitlines()[1:]:
        fields = line.split()
        if len(fields) < 9:
            continue
        fd, file_type, name = fields[3], fields[4], fields[-1]
        if (file_type == "REG" and re.search(r"[wu]$", fd)
                and name.startswith(str(expected).rstrip("/") + "/")):
            path = Path(name)
            if path.is_file() and is_ram(path):
                active.append(name)
    if active:
        for path in sorted(set(active)):
            findings.append(f"Mattermost: PID {pid} has RAM log file open: {path}")
    else:
        findings.append(
            f"Mattermost: PID {pid} has no identifiable writable regular log file under {expected}"
        )
    return findings

def inventory():
    """Discover active log file descriptors and classify their backing filesystem."""
    records = {}
    if not shutil.which("lsof"):
        payload = {"available": False, "error": "lsof is not installed", "logs": []}
        print(json.dumps(payload, indent=2))
        return
    rc, out = run(["lsof", "-nP", "-w", "-Fpcfn"])
    if rc and not out:
        payload = {"available": False, "error": out or "lsof returned no inventory", "logs": []}
        print(json.dumps(payload, indent=2))
        return
    pid = command = fd = None
    for line in out.splitlines():
        if not line:
            continue
        kind, value = line[0], line[1:]
        if kind == "p":
            pid, command, fd = value, "unknown", None
        elif kind == "c":
            command = value
        elif kind == "f":
            fd = value
        elif kind == "n" and pid and fd:
            path = value
            if not path.startswith(("/var/log/", "/run/log/", "/run/rsyslog/", "/run/bjm-app-logs/")):
                continue
            p = Path(path)
            if not p.exists() or not p.is_file():
                continue
            fs = mount_type(p)
            state = "RAM" if fs in ("tmpfs", "ramfs") else "HDD"
            key = (command, path, state)
            item = records.setdefault(key, {"source": command, "path": path, "state": state,
                                             "filesystem": fs, "writers": []})
            writer = {"pid": pid, "fd": fd}
            if writer not in item["writers"]:
                item["writers"].append(writer)
    logs = sorted(records.values(), key=lambda x: (x["source"], x["path"]))
    # Add only explicitly disabled logging settings; absence of a file is not proof of disablement.
    mm_cfg = Path("/opt/mattermost/config/config.json")
    if mm_cfg.exists():
        try:
            mm = json.loads(mm_cfg.read_text()).get("LogSettings", {})
            if not mm.get("EnableFile", False):
                logs.append({"source": "Mattermost file logging", "path": str(mm_cfg),
                             "state": "Disabled", "filesystem": "n/a", "writers": [],
                             "evidence": "LogSettings.EnableFile=false"})
        except Exception:
            pass
    payload = {"available": True, "generated": dt.datetime.now().astimezone().isoformat(),
               "logs": logs,
               "note": "Inventory covers active file descriptors under /var/log and managed /run log trees, plus explicit Mattermost file-logging disablement. It cannot infer every application's internal or remote logging destination."}
    print(json.dumps(payload, indent=2))


def status():
    sources, archive = read_config()
    print(f"RAMLog Manager {VERSION} — {socket.gethostname()}")
    print(f"Archive destination: {archive} (filesystem={mount_type(archive.parent if archive.parent.exists() else Path('/var/log'))})")
    print("\nConfigured sources:")
    for p in sources:
        print(f"  {p}: {'present' if p.exists() else 'missing'}; filesystem={mount_type(p)}")
    print("\nServices:")
    for svc in ("systemd-journald", "rsyslog", "apache2", "nginx", "php8.4-fpm", "postgresql", "mattermost"):
        print(f"  {svc}: {run(['systemctl', 'is-active', svc])[1]}")
    print(f"\nShutdown exporter: {run(['systemctl', 'is-enabled', 'ramlog-export.service'])[1]}")

def audit():
    print(f"RAMLog audit — {socket.gethostname()} (v{VERSION})")
    writers = open_persistent_writers()
    print("\n[Open persistent log files]")
    if writers is None:
        print("lsof unavailable; install lsof for process-level detection.")
    elif writers:
        print("\n".join(writers))
    else:
        print("(none detected)")
    print("\n[Persistent files under /var/log — inventory only]")
    rc, out = run(["find", "/var/log", "-xdev", "-type", "f", "-printf", "%s bytes\t%u:%g\t%p\n"])
    print(out or "(none found)")
    print("\n[Journal]")
    print(run(["journalctl", "--disk-usage"])[1])

def verify():
    failures = []
    print(f"RAMLog verification — {socket.gethostname()} (v{VERSION})")
    for p in [Path("/run/log/journal"), Path("/run/rsyslog"), RUNTIME]:
        fs = mount_type(p)
        print(f"{p}: {fs}")
        if not p.exists() or not is_ram(p):
            failures.append(f"required RAM log path missing/not RAM-backed: {p}")
    writers = open_persistent_writers()
    if writers is None:
        failures.append("lsof unavailable; cannot verify process writers")
    elif writers:
        failures.append("open persistent /var/log descriptors detected (some may be inherited/stale; they are not assumed harmless):")
        failures.extend(writers)
    pg_findings = postgresql_verification()
    if pg_findings:
        print("\n[PostgreSQL logging verification]")
        for item in pg_findings:
            print(" - " + item)
            if "verification remains incomplete" in item or "NOT verified" in item or "unknown" in item or "not identified" in item or "cannot inspect" in item or "unavailable" in item or "no identifiable RAM log" in item:
                failures.append(item)
    mm_findings = mattermost_verification()
    if mm_findings:
        print("\n[Mattermost logging verification]")
        for item in mm_findings:
            print(" - " + item)
            if "has RAM log file open:" not in item and "not installed; skipped" not in item:
                failures.append(item)
    if UNSUPPORTED:
        failures.extend(UNSUPPORTED)
    logrotate_conf = Path("/etc/logrotate.d/ramlog-manager")
    if not logrotate_conf.exists():
        failures.append("RAM log rotation policy is missing: /etc/logrotate.d/ramlog-manager")
    elif not shutil.which("logrotate"):
        failures.append("logrotate is unavailable; RAM log growth is not bounded")
    else:
        rc, out = run(["logrotate", "-d", "/etc/logrotate.conf"])
        if rc:
            failures.append("logrotate configuration validation failed: " + out)
    exporter = run(["systemctl", "is-enabled", "ramlog-export.service"])[1]
    if exporter != "enabled":
        failures.append("shutdown RAM-log exporter is not enabled: " + exporter)
    archive = read_config()[1]
    # Test the configured archive directory itself, not merely its parent.
    # Verification does not create or alter the archive directory.
    if not archive.exists():
        failures.append(f"archive destination does not exist: {archive}")
    elif not archive.is_dir():
        failures.append(f"archive destination is not a directory: {archive}")
    else:
        try:
            fd, probe = tempfile.mkstemp(prefix=".ramlog-write-test-", dir=str(archive))
            os.close(fd)
            os.unlink(probe)
        except OSError as exc:
            failures.append(f"archive destination not writable: {archive}: {exc}")
    print("\nRESULT: " + ("PASS" if not failures else "FAIL / INCOMPLETE"))
    for item in failures:
        print(" - " + item)
    return 0 if not failures else 2

def export():
    require_root()
    sources, archive_dir = read_config()
    existing = [p for p in sources if p.exists()]
    unsafe = [p for p in existing if not is_ram(p)]
    if unsafe:
        raise SystemExit("REFUSED: non-RAM source(s): " + ", ".join(map(str, unsafe)))
    if not existing:
        raise SystemExit("No configured RAM sources exist.")
    archive_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(archive_dir, 0o700)
    stamp = dt.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
    target = archive_dir / f"{socket.gethostname()}-ram-logs-{stamp}.tar.gz"
    fd, name = tempfile.mkstemp(prefix="ramlog-", suffix=".tmp", dir=archive_dir)
    os.close(fd)
    tmp = Path(name)
    try:
        with tarfile.open(tmp, "w:gz") as tf:
            for p in existing:
                tf.add(p, arcname=str(p).lstrip("/"), recursive=True)
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
    finally:
        tmp.unlink(missing_ok=True)
    digest = hashlib.sha256(target.read_bytes()).hexdigest()
    manifest = target.with_suffix(target.suffix + ".sha256")
    manifest.write_text(f"{digest}  {target.name}\n")
    os.chmod(manifest, 0o600)
    print(f"Archive created: {target}\nSHA-256: {digest}")

def main():
    parser = argparse.ArgumentParser(description="RAM-first logging manager for Debian/Ubuntu")
    parser.add_argument("command", choices=("status", "audit", "inventory", "mattermost-fix", "apply", "verify", "export"))
    args = parser.parse_args()
    actions = {"status": status, "audit": audit, "inventory": inventory, "mattermost-fix": mattermost_fix, "apply": configure,
               "verify": verify, "export": export}
    result = actions[args.command]()
    if args.command == "verify":
        raise SystemExit(result)

if __name__ == "__main__":
    main()
