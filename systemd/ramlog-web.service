[Unit]
Description=RAMLog Manager standalone web interface
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/ramlog-web
Restart=on-failure
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The web process can write only to the specific configuration and backup
# locations required by the RAMLog adapter. Do not grant the whole /etc tree.
ReadWritePaths=/etc/ramlog
ReadWritePaths=/etc/tmpfiles.d
ReadWritePaths=/etc/systemd/journald.conf.d
ReadWritePaths=/etc/logrotate.d
ReadWritePaths=/etc/apache2
ReadWritePaths=/etc/nginx
ReadWritePaths=/etc/php
ReadWritePaths=/etc/postgresql
ReadWritePaths=/etc/rsyslog.d
ReadWritePaths=/etc/lightdm
ReadWritePaths=/var/backups
ReadWritePaths=/run
ReadWritePaths=/opt/mattermost/config
ProtectHome=true

[Install]
WantedBy=multi-user.target
