[Unit]
Description=RAMLog Manager standalone web interface
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/ramlog-web
Restart=on-failure
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/ramlog
ProtectHome=true

[Install]
WantedBy=multi-user.target
